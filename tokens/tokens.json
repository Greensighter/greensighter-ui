    "body-s": { "$value": { "fontFamily": "{font.family.body}", "fontWeight": "{font.weight.regular}", "fontSize": "{font.size.xs}", "lineHeight": "{font.line-height.xs}", "letterSpacing": "0em" } },
    "label-m": { "$value": { "fontFamily": "{font.family.body}", "fontWeight": "{font.weight.medium}", "fontSize": "{font.size.xs}", "lineHeight": "{font.line-height.xs}", "letterSpacing": "0em" } },
    "label-s": { "$value": { "fontFamily": "{font.family.body}", "fontWeight": "{font.weight.medium}", "fontSize": "{font.size.xxs}", "lineHeight": "{font.line-height.xxs}", "letterSpacing": "0em" } },
    "caption": { "$value": { "fontFamily": "{font.family.body}", "fontWeight": "{font.weight.regular}", "fontSize": "{font.size.xxs}", "lineHeight": "{font.line-height.xxs}", "letterSpacing": "0em" } }
