  "radius": {
    "$description": "Chips and pills: full. Cards: 2xl. Large glass panels: 4xl.",
    "$type": "dimension",
    "none": { "$value": "0px" },
    "xs": { "$value": "4px" },
    "sm": { "$value": "8px" },
    "md": { "$value": "12px" },
    "lg": { "$value": "16px" },
    "xl": { "$value": "20px" },
    "2xl": { "$value": "24px" },
    "3xl": { "$value": "32px" },
    "4xl": { "$value": "48px" },
    "5xl": { "$value": "56px" },
    "6xl": { "$value": "64px" },
    "7xl": { "$value": "72px" },
    "8xl": { "$value": "80px" },
    "9xl": { "$value": "96px" },
    "full": { "$value": "9999px" }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "title": { "$value": ["Safiro", "Helvetica Neue", "Arial", "sans-serif"] },
      "body": { "$value": ["Safiro", "Helvetica Neue", "Arial", "sans-serif"] }
    },
    "weight": {
      "$type": "fontWeight",
      "thin": { "$value": 200, "$extensions": { "figma.style": "35 Thin" } },
      "light": { "$value": 300, "$extensions": { "figma.style": "45 Light" } },
      "regular": { "$value": 400, "$extensions": { "figma.style": "Regular" } },
      "medium": { "$value": 500, "$extensions": { "figma.style": "Medium" } },
      "bold": { "$value": 700, "$extensions": { "figma.style": "75 Bold" } }
    },
    "size": {
      "$type": "dimension",
      "xxs": { "$value": "12px" },
