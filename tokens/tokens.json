  "text-style": {
    "$type": "typography",
    "display-xl": { "$value": { "fontFamily": "{font.family.title}", "fontWeight": "{font.weight.medium}", "fontSize": "{font.size.9xl}", "lineHeight": "{font.line-height.9xl}", "letterSpacing": "-0.02em" } },
    "display-l": { "$value": { "fontFamily": "{font.family.title}", "fontWeight": "{font.weight.medium}", "fontSize": "{font.size.7xl}", "lineHeight": "{font.line-height.7xl}", "letterSpacing": "-0.02em" } },
    "h1": { "$value": { "fontFamily": "{font.family.title}", "fontWeight": "{font.weight.medium}", "fontSize": "{font.size.5xl}", "lineHeight": "{font.line-height.5xl}", "letterSpacing": "-0.015em" } },
    "h2": { "$value": { "fontFamily": "{font.family.title}", "fontWeight": "{font.weight.medium}", "fontSize": "{font.size.3xl}", "lineHeight": "{font.line-height.3xl}", "letterSpacing": "-0.01em" } },
    "h3": { "$value": { "fontFamily": "{font.family.title}", "fontWeight": "{font.weight.medium}", "fontSize": "{font.size.2xl}", "lineHeight": "{font.line-height.2xl}", "letterSpacing": "-0.005em" } },
    "h4": { "$value": { "fontFamily": "{font.family.title}", "fontWeight": "{font.weight.medium}", "fontSize": "{font.size.xl}", "lineHeight": "{font.line-height.xl}", "letterSpacing": "0em" } },
    "body-l": { "$value": { "fontFamily": "{font.family.body}", "fontWeight": "{font.weight.regular}", "fontSize": "{font.size.lg}", "lineHeight": "{font.line-height.lg}", "letterSpacing": "0em" } },
