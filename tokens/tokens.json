    "56": { "$value": "56px" },
    "64": { "$value": "64px" },
    "72": { "$value": "72px" },
    "80": { "$value": "80px" },
    "88": { "$value": "88px" },
    "96": { "$value": "96px" },
    "104": { "$value": "104px" },
    "112": { "$value": "112px" },
    "120": { "$value": "120px" },
    "128": { "$value": "128px" },
    "136": { "$value": "136px" },
