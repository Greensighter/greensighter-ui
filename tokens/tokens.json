      "300": { "$value": "#ffa2a2" },
      "400": { "$value": "#fd565b" },
      "500": { "$value": "#ed3d3d" },
      "600": { "$value": "#e7000b" },
      "700": { "$value": "#c10007" },
      "800": { "$value": "#9f0712" },
      "900": { "$value": "#82181a" }
    },
    "yellow": {
      "100": { "$value": "#fef9c2" },
      "200": { "$value": "#fff085" },
      "300": { "$value": "#ffdf20" },
      "400": { "$value": "#ffc456" },
      "500": { "$value": "#f0b100" },
      "600": { "$value": "#d08700" },
      "700": { "$value": "#a65f00" },
      "800": { "$value": "#894b00" },
      "900": { "$value": "#733e0a" }
