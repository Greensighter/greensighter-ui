{
  "$description": "Greensighter design tokens, exported from the Figma file 'Design System' (TGZXUIB6V7Z5b6rO5q4zHb). Format: W3C Design Tokens (DTCG). Edit here, then run `npm run build` to regenerate css/tokens.css.",
  "color": {
    "$type": "color",
    "white": { "$value": "#ffffff" },
    "gray": {
      "25": { "$value": "#fbfbfb" },
      "50": { "$value": "#f5f5f5" },
      "100": { "$value": "#f1f1f1" },
      "200": { "$value": "#d4d4d7" },
