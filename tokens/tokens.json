    "transparent": {
      "white-8": { "$value": "#ffffff14" },
      "white-12": { "$value": "#ffffff1f" },
      "white-20": { "$value": "#ffffff33" },
      "white-32": { "$value": "#ffffff52" },
      "white-64": { "$value": "#ffffffa3" },
      "dark-6": { "$value": "#04040c0f" },
      "dark-10": { "$value": "#04040c1a" },
      "dark-20": { "$value": "#04040c33" },
      "dark-32": { "$value": "#04040c52" },
      "dark-64": { "$value": "#04040ca3" },
      "purple-24": { "$value": "#7583fa3d" }
    }
  },

  "theme": {
    "$description": "Semantic colors. Dark for thumbnails and social posts, Light for blog infographics.",
    "$type": "color",
    "dark": {
      "bg": {
        "canvas": { "$value": "{color.gray.900}" },
        "surface": { "$value": "{color.gray.850}" },
        "surface-raised": { "$value": "{color.gray.800}" },
        "glass": { "$value": "{color.transparent.white-8}" },
        "inverse": { "$value": "{color.white}" },
        "accent": { "$value": "{color.purple.700}" },
        "accent-soft": { "$value": "{color.transparent.purple-24}" }
      },
      "text": {
        "primary": { "$value": "{color.white}" },
        "secondary": { "$value": "{color.gray.300}" },
        "muted": { "$value": "{color.gray.500}" },
        "accent": { "$value": "{color.purple.300}" },
        "on-accent": { "$value": "{color.white}" },
        "inverse": { "$value": "{color.gray.900}" }
      },
      "border": {
        "subtle": { "$value": "{color.transparent.white-12}" },
        "strong": { "$value": "{color.transparent.white-20}" },
        "glass": { "$value": "{color.transparent.white-20}" },
        "accent": { "$value": "{color.purple.500}" }
      },
      "status": {
        "positive": { "$value": "{color.green.500}" },
        "negative": { "$value": "{color.red.400}" },
        "warning": { "$value": "{color.yellow.400}" }
      },
      "chart": {
        "1": { "$value": "{color.purple.700}" },
        "2": { "$value": "{color.purple.500}" },
        "3": { "$value": "{color.purple.300}" },
        "4": { "$value": "{color.green.500}" },
        "5": { "$value": "{color.accent.pink}" },
        "neutral": { "$value": "{color.gray.600}" }
      }
    },
    "light": {
      "bg": {
        "canvas": { "$value": "{color.gray.50}" },
        "surface": { "$value": "{color.white}" },
        "surface-raised": { "$value": "{color.gray.25}" },
        "glass": { "$value": "{color.transparent.white-64}" },
        "inverse": { "$value": "{color.gray.900}" },
        "accent": { "$value": "{color.purple.700}" },
        "accent-soft": { "$value": "{color.purple.50}" }
      },
      "text": {
        "primary": { "$value": "{color.gray.900}" },
        "secondary": { "$value": "{color.gray.600}" },
        "muted": { "$value": "{color.gray.400}" },
        "accent": { "$value": "{color.purple.700}" },
        "on-accent": { "$value": "{color.white}" },
        "inverse": { "$value": "{color.white}" }
      },
      "border": {
        "subtle": { "$value": "{color.gray.200}" },
        "strong": { "$value": "{color.gray.300}" },
        "glass": { "$value": "{color.transparent.white-64}" },
        "accent": { "$value": "{color.purple.500}" }
      },
      "status": {
        "positive": { "$value": "{color.green.600}" },
        "negative": { "$value": "{color.red.500}" },
        "warning": { "$value": "{color.yellow.600}" }
      },
      "chart": {
        "1": { "$value": "{color.purple.700}" },
        "2": { "$value": "{color.purple.500}" },
        "3": { "$value": "{color.purple.300}" },
        "4": { "$value": "{color.green.600}" },
        "5": { "$value": "{color.accent.pink}" },
        "neutral": { "$value": "{color.gray.200}" }
      }
    }
  },

  "spacing": {
    "$description": "8px grid, 4px for fine detail. Use for gaps and padding.",
    "$type": "dimension",
    "0": { "$value": "0px" },
    "2": { "$value": "2px" },
